{
  "name": "flapjack-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check_build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:browser-tests:unmocked": "eslint --config browser-tests-unmocked/eslint.config.mjs --max-warnings 0 'browser-tests-unmocked/**/*.spec.ts'",
    "test": "vitest run",
    "test:browser:unmocked": "playwright test --config browser-tests-unmocked/playwright.config.ts",
    "test:unit:run": "vitest run component-tests"
  },
  "dependencies": {
    "@sveltejs/kit": "2.70.2",
    "svelte": "5.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "jsdom": "^28.1.0",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "license": "Elastic-2.0"
}
