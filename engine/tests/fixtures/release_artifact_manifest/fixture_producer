#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE="$SCRIPT_DIR/aarch64_build_info_fixture_source"
OUTPUT="${1:-$SCRIPT_DIR/aarch64_build_info_fixture}"

command -v aarch64-linux-musl-gcc >/dev/null 2>&1 || {
  printf 'ERROR: aarch64-linux-musl-gcc is required to regenerate the fixture\n' >&2
  exit 1
}

aarch64-linux-musl-gcc \
  -x c \
  -nostdlib \
  -static \
  -Os \
  -s \
  -fno-ident \
  -fno-stack-protector \
  -fno-unwind-tables \
  -fno-asynchronous-unwind-tables \
  -Wl,-e,_start \
  -Wl,--build-id=none \
  -o "$OUTPUT" \
  "$SOURCE"

chmod +x "$OUTPUT"
printf '%s\n' "$OUTPUT"
